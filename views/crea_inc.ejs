<!DOCTYPE html>
<html>

<head>
    <link rel="stylesheet" href="/styles/style.css">
    <link rel="stylesheet" href="/styles/create_account.css">


</head>

<body>
    <header>
        <a href="/"><img src="/images/logo.png" alt="Logo"></a>
        <div class="header-content2">
            <a href="create_account.html">
                <p id="username">Nom d'utilisateur</p>
            </a>
        </div>
    </header>
    <div class="creat_inc_container container">
        <h3>Signaler un nouvel incident</h3>
        <form action="/incident" method="POST" class="form inc-form">
            <div class="input-container">
                <input type="text" name="description" placeholder="Description" class="input" required>
                <input type="text" name="adresse" placeholder="Adresse" class="input" required>
            </div>
            <div class="input-container">
                <input type="text" name="signale_par" placeholder="Signalé par" class="input" required>
                <input type="date" name="date" class="input">
            </div>
            <button type="submit" class="login-button">Envoyer</button>
        </form>
    </div>
</body>

</html>